# =====================================================================
# Configurazione per lo stack Docker locale (Supabase self-hosted).
# Copia questo file in ".env" nella root del progetto per usarlo con
# `docker compose up -d`. NON è il tuo .env con le chiavi di Supabase Cloud:
# se ne hai già uno per il progetto cloud, fanne un backup prima di sovrascriverlo.
#
# Le chiavi JWT/ANON/SERVICE_ROLE qui sotto sono le chiavi DEMO PUBBLICHE
# documentate nella guida ufficiale di self-hosting di Supabase
# (https://supabase.com/docs/guides/self-hosting/docker). Vanno benissimo per
# uno stack che gira SOLO su localhost. Se mai esponi questo stack oltre il
# tuo Mac (tunnel, rete locale condivisa, server), DEVI generare un JWT_SECRET
# nuovo e le relative ANON_KEY/SERVICE_ROLE_KEY, altrimenti chiunque può
# autenticarsi come service_role sul tuo database.
# =====================================================================

############
# Segreti (demo, solo per uso locale - vedi nota sopra)
############
POSTGRES_PASSWORD=postgres-local-dev-password
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlzcyI6ICJzdXBhYmFzZS1kZW1vIiwKICAgICJpYXQiOiAxNjQxNzY5MjAwLAogICAgImV4cCI6IDE3OTk1MzU2MDAKfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=this_password_is_insecure_and_should_be_updated
SECRET_KEY_BASE=UpNVntn3cDxHJpq99YMc1T1AQgQpc8kfYTuRgBiYa15BLrx8etQoXz3gZv1/u2oq
PG_META_CRYPTO_KEY=your-encryption-key-32-chars-min

############
# Database
############
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

############
# Kong (API gateway)
############
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

############
# PostgREST
############
PGRST_DB_SCHEMAS=public,graphql_public

############
# Auth (GoTrue)
############
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
API_EXTERNAL_URL=http://localhost:8000

MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

ENABLE_EMAIL_SIGNUP=true
# true = login immediato dopo la registrazione, senza dover cliccare il link di conferma.
# Metti a false se vuoi testare il flusso di conferma email (leggibile su Mailpit, http://localhost:8025).
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false

ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

# SMTP locale (Mailpit): tutte le email (conferma registrazione, reset password)
# vengono catturate qui invece di essere inviate davvero. UI: http://localhost:8025
SMTP_ADMIN_EMAIL=admin@istintopuro.local
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Istinto Puro (locale)

# Google OAuth: disabilitato di default in locale (il bottone "Continua con Google"
# fallirà con un errore gestito lato client). Per abilitarlo: valorizza le tre
# variabili sotto E scommenti le righe GOTRUE_EXTERNAL_GOOGLE_* nel servizio
# "auth" di docker-compose.yml.
# GOOGLE_ENABLED=true
# GOOGLE_CLIENT_ID=
# GOOGLE_SECRET=

############
# Studio
############
STUDIO_DEFAULT_ORGANIZATION=Istinto Puro
STUDIO_DEFAULT_PROJECT=Istinto Puro (locale)
SUPABASE_PUBLIC_URL=http://localhost:8000

############
# App (questo progetto)
############
# "dev" = Vite in hot-reload (default). "prod" = build statica servita da Express.
APP_TARGET=dev
APP_NODE_ENV=development

# Consumate dal BROWSER: devono restare raggiungibili dal browser dell'utente
# (http://localhost:8000, la porta di Kong esposta sull'host), MAI il nome
# interno del servizio Docker "kong".
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE

# Facoltativa: serve solo per "npm run import-data" (import squadre/giocatori da API-Football).
# Senza questa chiave puoi comunque giocare se importi/carichi dati con un altro metodo (vedi DOCKER.md).
API_FOOTBALL_KEY=
